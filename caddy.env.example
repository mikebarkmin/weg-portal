# caddy.env.example — copy to caddy.env and fill in.
# caddy.env is NOT committed (see .gitignore).

## Site address: "localhost" for the container-local test setup,
## the real domain (e.g. portal.example.com) in production.
WEG_SITE_ADDRESS=localhost

## Basic auth for the PocketBase admin UI /_/
## User name (anything you like) ...
WEG_ADMIN_BASIC_USER=portal
## ... and the bcrypt hash of the password, NOT the password itself.
## Generate with:
##   docker run --rm docker.io/library/caddy:2-alpine \
##     caddy hash-password --plaintext 'SECRET'
## (for scripting: caddy hash-password reads from stdin when run without
## a plaintext argument)
WEG_ADMIN_BASIC_HASH=$2a$14$REPLACE_WITH_GENERATED_BCRYPT_HASH
