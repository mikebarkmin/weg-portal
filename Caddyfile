# Caddy reverse proxy for the WEG community portal.
#
# Container-local / test default: TLS via Caddy's internal CA
# ("tls internal", self-signed -> curl -k). For production only the site
# address and the tls directive need to change, see "PRODUCTION VARIANT"
# below and docs/deploy.md.
#
# Required environment variables (passed via the caddy service env file,
# see caddy.env.example):
#   WEG_SITE_ADDRESS     site label / hostname, e.g. "localhost" or
#                        "portal.example.com"
#   WEG_ADMIN_BASIC_HASH bcrypt hash protecting /_/ , generate with:
#                        docker run --rm docker.io/library/caddy:2-alpine \
#                          caddy hash-password --plaintext 'SECRET'

{
	# no admin endpoint exposure
	admin off
	# keep log output small; no access logs (rate limits live in PocketBase)
	log {
		level INFO
	}
}

{$WEG_SITE_ADDRESS:localhost} {
	# ---- TLS -----------------------------------------------------------
	# local/test: internal CA. Replace in production (see below).
	tls internal

	# ---- security headers ----------------------------------------------
	header {
		# HSTS: browsers must use HTTPS for a year (all subroutes)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# admins must never be embeddable
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
	}

	# ---- PocketBase admin UI /_/ -----------------------------------------
	# Default variant: HTTP basic auth in front of /_/
	# (defense in depth; the admin API itself additionally requires a
	# superuser token). Alternative: remote_ip allowlist, see comment below.
	handle /_* {
		basic_auth {
			{$WEG_ADMIN_BASIC_USER:portal} {$WEG_ADMIN_BASIC_HASH}
		}
		reverse_proxy portal:8080 {
			# the basic-auth Authorization header must not leak into
			# PocketBase (it would be parsed as an invalid superuser
			# token and /_/ would answer 401)
			header_up -Authorization
			# do not buffer SSE / realtime connections
			flush_interval -1
		}
	}

	# ---- everything else: SPA + API -------------------------------------
	reverse_proxy portal:8080 {
		# do not buffer SSE / realtime connections
		flush_interval -1
	}
}

# ---------------------------------------------------------------------------
# PRODUCTION VARIANT (real domain + Let's Encrypt)
#
# 1. Set in caddy.env:
#        WEG_SITE_ADDRESS=portal.example.com
# 2. DNS A record for the domain must point at this host
#    (Let's Encrypt HTTP-01 must be reachable from outside).
# 3. Replace the "tls internal" line above with:
#        tls {
#            protocols tls1.2 tls1.3
#        }
#    Caddy then fetches and renews a Let's Encrypt certificate automatically.
#    For an initial dry run use the staging CA to avoid rate limits:
#        acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
#
# ALTERNATIVE /_/-SCHUTZ: IP-ALLOWLIST VARIANT (instead of basic_auth)
#
# Replace the basic_auth block in handle /_* with:
#        @internal {
#            remote_ip 203.0.113.10 203.0.113.0/24
#        }
#        handle @internal {
#            reverse_proxy portal:8080 {
#                flush_interval -1
#            }
#        }
#        # everyone else gets a fixed 404, revealing nothing
#        respond 404
#
# (keep basic_auth AND allowlist is also possible; layering them is the
# most restrictive variant)
