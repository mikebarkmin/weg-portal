#!/usr/bin/env bash
# weg-portal-ctl - the one command for operating the WEG portal on the server.
#
# Installed as /usr/local/sbin/weg-portal-ctl (root:root 0755) by
# deploy/server-setup.sh. The deploy user may run it via sudo, nothing else,
# so a leaked deploy key cannot touch the rest of the server.
#
#   weg-portal-ctl status                 version, service state, health
#   weg-portal-ctl deploy <vX.Y.Z>        install incoming/weg-portal-<v>, back
#                                         up, switch, verify; rolls back
#                                         binary AND data if unhealthy
#   weg-portal-ctl rollback [<vX.Y.Z>]    switch to the previous (or given)
#                                         installed version, data unchanged
#   weg-portal-ctl backup [<label>]       consistent snapshot of pb_data
#                                         (service stopped for a few seconds)
#   weg-portal-ctl nightly                copy the newest nightly PocketBase
#                                         backup (no downtime)
#   weg-portal-ctl restore <file>         replace pb_data with a *.tar.gz backup
#   weg-portal-ctl superuser <email>      create/update a superuser, password
#                                         from stdin (root only, not via sudo)
#
# Backup commands print the created file as the last line.
set -euo pipefail

BASE=/srv/weg-portal
SERVICE=weg-portal
SERVICE_USER=weg-portal
HEALTH_URL=http://127.0.0.1:8090/api/health
KEEP_RELEASES=5
KEEP_BACKUPS=10

releases=$BASE/releases
data=$BASE/pb_data
backups=$BASE/backups
incoming=$BASE/incoming

log() { echo "weg-portal-ctl: $*" >&2; }
die() { log "$*"; exit 1; }

valid_version() { [[ "$1" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9.-]+)?$ ]]; }

current_version() {
    local target
    target=$(readlink "$BASE/current" 2>/dev/null) || return 0
    basename "$target"
}

is_active() { systemctl is-active --quiet "$SERVICE"; }

healthy() {
    local i
    for i in $(seq 1 "${1:-30}"); do
        curl -fsS "$HEALTH_URL" > /dev/null 2>&1 && return 0
        sleep 1
    done
    return 1
}

# backup files are readable by the calling admin/deploy user, so they can be
# downloaded with scp (scripts/backup.sh), but by nobody else
own_backup() {
    local group=root
    if [ -n "${SUDO_USER:-}" ]; then
        group=$(id -gn "$SUDO_USER")
    fi
    chown "root:$group" "$1"
    chmod 0640 "$1"
}

prune() { # <glob prefix> <keep>
    # shellcheck disable=SC2012
    ls -1t "$backups"/"$1"-* 2>/dev/null | tail -n +"$(($2 + 1))" | xargs -r rm -f --
}

snapshot() { # <label> [keep-stopped] - prints the archive path
    local label=$1 keep_stopped=${2:-} was_active=0 file
    [[ "$label" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid label '$label'"
    mkdir -p "$backups"
    [ -d "$data" ] || die "no data directory $data"
    file="$backups/$label-$(date +%Y%m%d-%H%M%S).tar.gz"

    if is_active; then
        was_active=1
        systemctl stop "$SERVICE"
    fi
    # never leave the portal down because the archive failed
    trap '[ "$was_active" = 1 ] && [ -z "$keep_stopped" ] && systemctl start "$SERVICE"' EXIT
    tar czf "$file" -C "$BASE" pb_data
    trap - EXIT
    if [ "$was_active" = 1 ] && [ -z "$keep_stopped" ]; then
        systemctl start "$SERVICE"
    fi

    own_backup "$file"
    prune "${label%%-*}" "$KEEP_BACKUPS"
    echo "$file"
}

restore_archive() { # <file> - service must be stopped
    local file=$1
    [ -f "$file" ] || die "no such backup: $file"
    tar tzf "$file" pb_data/ > /dev/null 2>&1 || die "$file is not a pb_data archive"
    find "$data" -mindepth 1 -delete
    tar xzf "$file" -C "$BASE"
    chown -R "$SERVICE_USER:$SERVICE_USER" "$data"
}

switch_to() { # <version>
    [ -x "$releases/$1/weg-portal" ] || die "version $1 is not installed"
    ln -sfn "releases/$1" "$BASE/current.new"
    mv -T "$BASE/current.new" "$BASE/current"
    echo "$(date -Iseconds) $1" >> "$BASE/history"
}

cmd_status() {
    local version
    version=$(current_version)
    echo "version:   ${version:-none}"
    echo "service:   $(systemctl is-active "$SERVICE" 2>/dev/null || true)"
    if curl -fsS "$HEALTH_URL" > /dev/null 2>&1; then echo "health:    ok"; else echo "health:    failing"; fi
    echo "installed: $(ls -1 "$releases" 2>/dev/null | tr '\n' ' ')"
    echo "backups:   $(ls -1 "$backups" 2>/dev/null | wc -l) in $backups"
}

cmd_deploy() {
    local version=${1:-} new previous archive
    valid_version "$version" || die "usage: deploy vX.Y.Z"
    new="$incoming/weg-portal-$version"
    [ -f "$new" ] || die "upload the binary to $new first"

    # the binary must run here and report the expected version
    chmod 0755 "$new"
    "$new" --version | grep -q " $version\$" || die "$new does not report version $version"

    install -d -m 0755 "$releases/$version"
    install -m 0755 -o root -g root "$new" "$releases/$version/weg-portal"
    rm -f "$new"

    previous=$(current_version)
    archive=""
    if [ -n "$previous" ] && [ -d "$data" ]; then
        archive=$(snapshot "pre-$version" keep-stopped)
        log "backup before the update: $archive"
    fi

    switch_to "$version"
    systemctl restart "$SERVICE"

    if healthy 45; then
        log "deployed $version (was ${previous:-none})"
        # keep the newest releases, never the running or previous one
        # shellcheck disable=SC2012
        ls -1t "$releases" | tail -n +"$((KEEP_RELEASES + 1))" | while read -r old; do
            [ "$old" = "$version" ] || [ "$old" = "$previous" ] || rm -rf -- "${releases:?}/$old"
        done
        return 0
    fi

    log "$version did not become healthy - last log lines:"
    journalctl -u "$SERVICE" -n 40 --no-pager >&2 || true
    if [ -n "$previous" ]; then
        log "rolling back to $previous and the data from before the update"
        systemctl stop "$SERVICE"
        [ -n "$archive" ] && restore_archive "$archive"
        switch_to "$previous"
        systemctl start "$SERVICE"
        healthy 45 && log "rollback to $previous is healthy" || log "ROLLBACK IS NOT HEALTHY - check the server"
    fi
    exit 1
}

cmd_rollback() {
    local target=${1:-} current
    current=$(current_version)
    if [ -z "$target" ]; then
        # the version that ran before the current one
        target=$(awk '{print $2}' "$BASE/history" 2>/dev/null | grep -vx "$current" | tail -n 1)
        [ -n "$target" ] || die "no previous version recorded"
    fi
    valid_version "$target" || die "invalid version '$target'"
    switch_to "$target"
    systemctl restart "$SERVICE"
    healthy 45 || die "$target is not healthy (see journalctl -u $SERVICE); if the data was migrated, restore the pre-update backup"
    log "now running $target (was $current); data unchanged"
}

cmd_nightly() {
    local latest file
    # shellcheck disable=SC2012
    latest=$(ls -1t "$data"/backups/*.zip 2>/dev/null | head -n 1)
    [ -n "$latest" ] || die "no nightly PocketBase backup yet ($data/backups)"
    mkdir -p "$backups"
    file="$backups/nightly-$(date +%Y%m%d-%H%M%S).zip"
    cp "$latest" "$file"
    own_backup "$file"
    prune nightly "$KEEP_BACKUPS"
    echo "$file"
}

cmd_restore() {
    local file=${1:-}
    [ -n "$file" ] || die "usage: restore <backups/file.tar.gz>"
    case "$file" in /*) ;; *) file="$backups/$(basename "$file")" ;; esac
    case "$(realpath "$file")" in "$backups"/*.tar.gz) ;; *) die "only .tar.gz files from $backups can be restored" ;; esac
    local was_active=0
    is_active && was_active=1
    # safety net: the current state is kept as well
    snapshot "before-restore" keep-stopped > /dev/null
    systemctl stop "$SERVICE" 2>/dev/null || true
    restore_archive "$file"
    if [ "$was_active" = 1 ]; then
        systemctl start "$SERVICE"
        healthy 45 || die "restored, but the portal is not healthy"
    fi
    log "restored $file"
}

cmd_superuser() {
    local email=${1:-} password
    [ -z "${SUDO_USER:-}" ] && [ "$(id -u)" = 0 ] || die "superuser: run as root directly (not via sudo from the deploy user)"
    [ -n "$email" ] || die "usage: superuser <email>  (password from stdin)"
    if [ -t 0 ]; then
        printf 'Password for %s: ' "$email" >&2
        IFS= read -rs password || true
        echo >&2
    else
        IFS= read -r password || true
    fi
    [ ${#password} -ge 10 ] || die "the password must have at least 10 characters"
    sudo -u "$SERVICE_USER" "$BASE/current/weg-portal" superuser upsert "$email" "$password" --dir "$data"
}

[ "$(id -u)" = 0 ] || die "run as root (sudo weg-portal-ctl ...)"

case "${1:-}" in
    status) cmd_status ;;
    deploy) cmd_deploy "${2:-}" ;;
    rollback) cmd_rollback "${2:-}" ;;
    backup) snapshot "${2:-manual}" ;;
    nightly) cmd_nightly ;;
    restore) cmd_restore "${2:-}" ;;
    superuser) cmd_superuser "${2:-}" ;;
    *) sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
